# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database — local MongoDB (the same instance MongoDB Compass connects to).
# See ../LOCAL-MONGODB-SETUP.md if this isn't running yet.
DB_URI=mongodb://127.0.0.1:27017/mern_starter

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# One-time admin seed (used only by src/seed/createAdmin.ts)
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_me_immediately

# Cloudinary (delete this section if the project has no image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
